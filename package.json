{
  "type": "module",
  "name": "iso",
  "version": "1.0.0",
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "server": "cd server && npm install && npm start",
    "server:dev": "cd server && npm install && npm run dev",
    "dev": "concurrently \"npm run server:dev\" \"npx http-server . -p 3000 -c-1\"",
    "setup": "npm install && cd server && npm install"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/?(*.)+(spec|test).js"
    ],
    "collectCoverageFrom": [
      "*.js",
      "!script.js",
      "!main.js"
    ],
    "transform": {},
    "globals": {
      "window": {}
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivan-fr/iso.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ivan-fr/iso/issues"
  },
  "homepage": "https://github.com/ivan-fr/iso#readme",
  "description": "",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jest": "^30.0.5"
  },
  "dependencies": {
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  }
}
