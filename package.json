{
  "type": "module",
  "name": "iso",
  "version": "1.0.0",
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/?(*.)+(spec|test).js"
    ],
    "collectCoverageFrom": [
      "*.js",
      "!script.js",
      "!main.js"
    ],
    "transform": {},
    "globals": {
      "window": {}
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivan-fr/iso.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ivan-fr/iso/issues"
  },
  "homepage": "https://github.com/ivan-fr/iso#readme",
  "description": "",
  "devDependencies": {
    "jest": "^30.0.5"
  }
}
